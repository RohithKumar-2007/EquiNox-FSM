<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="create_work_order_exception" author="system">
        <createTable tableName="work_order_exception">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="work_order_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_wo_exception_work_order"
                             references="work_order(id)" deleteCascade="true"/>
            </column>
            <column name="company_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_wo_exception_company"
                             references="company(id)" deleteCascade="true"/>
            </column>
            <column name="exception_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="severity" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="detected_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(1000)"/>
            <column name="previous_technician_id" type="BIGINT">
                <constraints foreignKeyName="fk_wo_exception_prev_tech"
                             references="own_user(id)"/>
            </column>
            <column name="replacement_technician_id" type="BIGINT">
                <constraints foreignKeyName="fk_wo_exception_repl_tech"
                             references="own_user(id)"/>
            </column>
            <column name="resolved_at" type="TIMESTAMP"/>
            <column name="resolution_notes" type="VARCHAR(2000)"/>
            <column name="auto_resolved" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="retry_count" type="INT" defaultValueNumeric="0"/>
            <column name="notification_sent" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="created_by" type="BIGINT"/>
            <column name="updated_by" type="BIGINT"/>
        </createTable>

        <createIndex tableName="work_order_exception" indexName="idx_wo_exception_company_status">
            <column name="company_id"/>
            <column name="status"/>
        </createIndex>
        <createIndex tableName="work_order_exception" indexName="idx_wo_exception_work_order">
            <column name="work_order_id"/>
        </createIndex>
        <createSequence sequenceName="work_order_exception_seq" startValue="1" incrementBy="50"/>
    </changeSet>
</databaseChangeLog>
